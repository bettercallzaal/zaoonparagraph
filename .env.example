# Paragraph "AI Assistant" API key. Settings > Workspace > Developer on paragraph.com.
# Scoped to the @thezao publication. Never commit the real value - this file is gitignored (.env, .env.*).
PARAGRAPH_API_KEY=

# Optional, read from the environment and never from this file: the path of a .env
# holding the key, for a worktree that has none. Used by automation/stage-socials.py.
# PARAGRAPH_ENV_FILE=

# The desk, dashboard/server.mjs. See dashboard/README.md.
# Required, 12 characters or more. The server will not start without it.
DASHBOARD_PASSWORD=
# Leave unset for a dry run: nothing reaches Paragraph or GitHub. 1 turns real writes on.
# DASHBOARD_LIVE=1
# Only to reach it from a phone: bind past localhost, and name the host you will type.
# DASHBOARD_HOST=
# DASHBOARD_PORT=4173
# DASHBOARD_ALLOWED_HOSTS=
# Set to 1 when it is served over TLS.
# DASHBOARD_SECURE_COOKIE=1
# Optional: the Open Canva button. Treat it as a secret, per the zabal-cover skill.
# CANVA_ZABAL_DESIGN_URL=
